# ─── Supabase ────────────────────────────────────────────────────────────────
# URL pública do projeto Supabase (não é segredo — vai para o bundle do cliente)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co

# Chave anon (não é segredo — vai para o bundle do cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de service role — SECRET: nunca expor no cliente nem em repositório público
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# Número da empresa no formato internacional sem + nem espaços
# Exemplo: 5511989525014 = +55 (11) 98952-5014
NEXT_PUBLIC_WHATSAPP_NUMBER=5511989525014

# ─── Site ────────────────────────────────────────────────────────────────────
# URL de produção do site (sem barra final)
# Usado em canonical URLs, sitemap, OG images e schemas JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# ─── Relatórios / Power BI ───────────────────────────────────────────────────
# Chave de autenticação para GET /api/reports — SECRET
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPORTS_API_KEY=64_chars_hex_aleatorio_aqui
